# ============================================================================
# CONFIGURAÇÃO DE CREDENCIAIS (USO PESSOAL)
# ============================================================================
# Copie este arquivo para .env (ou rode ./start.sh login) e preencha com
# O SEU PRÓPRIO LOGIN E SENHA. Nunca compartilhe o seu arquivo .env.

# 1. Credenciais da Kalodata (usadas pelo scraper.py)
# Você pode colocar 1 e-mail ou vários separados por vírgula (ex: conta1@gmail.com,conta2@gmail.com)
# Todas as contas listadas devem usar a mesma senha definida em KALODATA_PASSWORD.
KALODATA_LOGINS=seu_email_kalodata@gmail.com
KALODATA_PASSWORD=sua_senha_kalodata_aqui

# 2. Credenciais do Google Flow (usadas pelo flow_video.py)
# Conta Google que tem acesso ao Google Flow (https://flow.google.com/)
# e possui um projeto chamado "renda extra" criado na tela inicial.
GOOGLE_LOGIN=seu_email_google@gmail.com
GOOGLE_PASSWORD=sua_senha_google_aqui
